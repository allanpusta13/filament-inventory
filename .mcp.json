    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": ["artisan", "boost:mcp"]
        },
        "tolaria": {
            "args": [
                "C:\\Users\\Eizkie - ASUS\\AppData\\Local\\Tolaria\\mcp-server\\index.js"
            ],
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "env": {
                "WS_UI_PORT": "9711"
