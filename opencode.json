{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": ["php", "artisan", "boost:mcp"]
        },
        "playwright": {
            "type": "local",
            "command": ["npx", "-y", "@playwright/mcp@latest"]
        },
        "headroom": {
            "type": "local",
            "command": ["headroom", "mcp", "run"]
        }
    },
    "provider": {
        "opencode": {
            "options": {
                "allow_fallbacks": true
            }
        }
    },
    "model": "opencode/nemotron-3.5-lightning-free",
    "agents": {
        "orchestrator": {
            "model": "opencode/nemotron-3.5-lightning-free",
            "fallback": "opencode/mimo-v2.5-free"
        },
        "architect": {
            "model": "opencode/nemotron-3.5-lightning-free",
            "fallback": "opencode/nemotron-3-ultra-free"
        },
        "backend": {
            "model": "opencode/mimo-v2.5-free",
            "fallback": "opencode/nemotron-3.5-lightning-free"
        },
        "frontend": {
            "model": "opencode/ling-3.0-flash-fin-free",
            "fallback": "opencode/mimo-v2.5-free"
        },
        "qa": {
            "model": "opencode/big-pickle-free",
            "fallback": "opencode/mimo-v2.5-free"
        },
        "security": {
            "model": "opencode/nemotron-3-ultra-free",
            "fallback": "opencode/nemotron-3.5-lightning-free"
        },
        "adversary": {
            "model": "opencode/nemotron-3-ultra-free",
            "fallback": "opencode/big-pickle-free"
        },
        "docs": {
            "model": "opencode/muse-spark-1.2-contributor-free",
            "fallback": "opencode/ling-3.0-flash-fin-free"
        }
    }
}
